# --- Server only. Never prefix these with VITE_ (that ships them to the browser).
OPENAI_API_KEY=
SUPABASE_URL=
# Supabase > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Optional
OPENAI_MODEL=gpt-5-mini
# Point at an OpenAI-compatible API (tests, proxies)
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=3001

# --- Browser. Public values, safe to ship.
VITE_SUPABASE_URL=
# Supabase > Project Settings > API > anon public key
VITE_SUPABASE_ANON_KEY=
